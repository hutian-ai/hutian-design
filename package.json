{
  "name": "@hutian-ai/design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist/ui",
    "dist/assistant-ui",
    "dist/beautiful-ui",
    "dist/chat",
    "dist/hooks",
    "dist/lib",
    "src/styles",
    "src/ui",
    "src/assistant-ui",
    "src/beautiful-ui",
    "src/chat",
    "notices",
    "LICENSE",
    "DESIGN.md",
    "docs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles/index.css",
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./assistant-ui/*": {
      "types": "./dist/assistant-ui/*.d.ts",
      "import": "./dist/assistant-ui/*.js"
    },
    "./beautiful-ui/*": {
      "types": "./dist/beautiful-ui/*.d.ts",
      "import": "./dist/beautiful-ui/*.js"
    },
    "./chat/*": {
      "types": "./dist/chat/*.d.ts",
      "import": "./dist/chat/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "vite --config apps/docs/vite.config.ts",
    "build:showcase": "pnpm docs:build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p apps/docs/tsconfig.json --noEmit",
    "preview": "vite preview --config apps/docs/vite.config.ts --host 127.0.0.1 --port 3342 --strictPort",
    "showcase:start": "node scripts/showcase-service.mjs start",
    "showcase:status": "node scripts/showcase-service.mjs status",
    "showcase:stop": "node scripts/showcase-service.mjs stop",
    "docs:dev": "vite --config apps/docs/vite.config.ts",
    "docs:build": "pnpm build && vite build --config apps/docs/vite.config.ts",
    "docs:start": "node scripts/showcase-service.mjs start",
    "docs:status": "node scripts/showcase-service.mjs status",
    "docs:stop": "node scripts/showcase-service.mjs stop",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "prepare": "husky",
    "lint:staged": "lint-staged"
  },
  "peerDependencies": {
    "@assistant-ui/react": "0.15.17",
    "@assistant-ui/react-lexical": "0.2.11",
    "@assistant-ui/react-markdown": "0.14.13",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "dependencies": {
    "@fullcalendar/react": "7.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.37.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react-day-picker": "10.0.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.3",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.12",
    "vaul": "1.1.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.17",
    "@assistant-ui/react-lexical": "0.2.11",
    "@assistant-ui/react-markdown": "0.14.13",
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.4",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.3.5"
  },
  "description": "React design system and Chat UI components for agent collaboration applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hutian-ai/hutian-design.git"
  },
  "homepage": "https://hutian-ai.github.io/hutian-design/",
  "bugs": {
    "url": "https://github.com/hutian-ai/hutian-design/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "chat-ui",
    "assistant-ui",
    "radix-ui"
  ]
}
